# BotFather'dan alinan Telegram bot token'i
TELEGRAM_BOT_TOKEN=

# Virgul ile ayrilmis sayisal Telegram user ID'leri (ilk ID guvenlik bildirimlerini alir)
# Kendi ID'nizi @userinfobot'a yazarak ogrenebilirsiniz.
ALLOWED_USER_IDS=123456789

# Google Drive'daki ana klasorun ID'si (sarki alt klasorlerini iceren klasor)
DRIVE_ROOT_FOLDER_ID=18v81QssO2Iu9UhjAvNAOVOqexjUvievT

# Videolara eklenecek sabit kucuk resim (thumbnail) dosyasi
DEFAULT_THUMBNAIL=data/images/default_thumbnail.jpg

# Gecici dosyalar (indirilen ses + uretilen mp4)
TEMP_DIR=data/temp

# Playwright kalici Chrome profili — Google oturumu burada yasar, ASLA paylasmayin
BROWSER_PROFILE_DIR=data/browser_profile

# Ilk kurulumda false (tarayiciyi gorerek calistirin); kararli calisinca true denenebilir.
# NOT: Google, headless modu yeni cihaz sanip her seferinde "Kimliginizi dogrulayin"
# diyalogu cikarabiliyor — bu durumda false'ta kalin.
HEADLESS=false

# Studio yuklemesi icin toplam zaman asimi (dakika)
UPLOAD_TIMEOUT_MINUTES=30
